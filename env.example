# ============================================
# CONFIGURACIÓN API VIRAL SCRAPER
# ============================================

# YouTube API (OBLIGATORIO)
# Obtener en: https://console.cloud.google.com/
# Tutorial: https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Instagram (OPCIONAL - mejora rate limits)
# Usa tu cuenta personal o crea una de prueba
INSTAGRAM_USER=tu_usuario_instagram
INSTAGRAM_PASS=tu_password_instagram

# TikTok MS Token (OPCIONAL - mejora scraping)
# Obtener desde cookies de navegador
# Tutorial: https://github.com/davidteather/TikTok-Api
TIKTOK_MS_TOKEN=tu_ms_token_aqui

# ============================================
# CONFIGURACIÓN FLASK
# ============================================
FLASK_ENV=production
FLASK_DEBUG=False
